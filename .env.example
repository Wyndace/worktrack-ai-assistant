LLM_PROVIDER=gigachat

# Ключ авторизации GigaChat API. Не коммитьте реальное значение.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_VERIFY_SSL_CERTS=true

# Резервный локальный провайдер для разработки без облачного API.
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434

# HTTP API. Для доступа с других устройств в локальной сети задайте 0.0.0.0.
APP_HOST=127.0.0.1
APP_PORT=8000
